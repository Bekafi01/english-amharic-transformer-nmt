# Environment Variables Template for English-Amharic Transformer NMT

# Hardware & Execution
CUDA_VISIBLE_DEVICES=0
DEVICE=cuda
NUM_WORKERS=4

# Paths Configuration
PROJECT_ROOT=.
CONFIG_DIR=configs
DATA_DIR=data
ARTIFACTS_DIR=artifacts

# Logging & Monitoring
LOG_LEVEL=INFO
TENSORBOARD_LOG_DIR=artifacts/tensorboard
WANDB_API_KEY=
WANDB_PROJECT=english-amharic-nmt
WANDB_ENTITY=

# Serving Configuration
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
