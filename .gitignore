# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors
.idea/
.vscode/
.ipynb_checkpoints/

# Data and artifacts: structure is tracked, contents are not
data/raw/*
data/processed/*
!data/**/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Docs milestones are tracked (small md/json). Everything else under artifacts is not.

# Working notes (plan, milestone logs) stay local
docs/internal/
